# Copie este arquivo para .env e preencha os valores reais.
# O .env nunca vai para o Git (veja .gitignore).

# Banco de dados (Neon/Postgres)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# WhatsApp que recebe os avisos de agendamento.
# Sem o 55 na frente o bot nao acha o numero.
NUMERO_BARBEIRO="5573982105264"

# ==========================================
# NOTIFICACAO NO CELULAR (ntfy)
#
# O bot roda no mesmo numero do barbeiro, e o WhatsApp nao notifica
# mensagem que voce mesmo enviou. O ntfy entrega o alerta de verdade.
#
# COMO CONFIGURAR:
#   1. Instale o app "ntfy" (Play Store / App Store)
#   2. Toque em + e inscreva-se EXATAMENTE no topico abaixo
#   3. Coloque o mesmo topico aqui no .env do servidor
#   4. Teste abrindo http://localhost:10000/api/teste-push
#
# IMPORTANTE: no servidor publico do ntfy, quem souber o nome do topico
# le as notificacoes. Use um nome longo e aleatorio e nao compartilhe.
# Se deixar vazio, o push fica desligado e o bot funciona normalmente.
# ==========================================
NTFY_TOPIC="barbearia-jonathan-860gw3axbi7jjcx8aulr"

# Trocar so se um dia voce subir um ntfy proprio.
# NTFY_SERVIDOR="https://ntfy.sh"

# Porta da API/painel
# PORT=10000
